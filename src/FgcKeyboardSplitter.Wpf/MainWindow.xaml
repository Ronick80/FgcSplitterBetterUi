<ui:FluentWindow
    x:Class="FgcKeyboardSplitter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FgcKeyboardSplitter"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FGC Keyboard Splitter"
    Width="1180"
    Height="820"
    MinWidth="720"
    MinHeight="480"
    Background="{StaticResource ArcadeBlack}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!-- Sidebar labels hide when the window is narrow, leaving only the icons. -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="ScaleRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Title="FGC KEYBOARD SPLITTER"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{StaticResource ArcadeSidebar}"
            FontFamily="{StaticResource ArcadeFont}"
            Foreground="{StaticResource ArcadeTextDim}" />

        <!-- Sidebar -->
        <Border
            x:Name="Sidebar"
            Grid.Row="1"
            Grid.Column="0"
            Width="236"
            Background="{StaticResource ArcadeSidebar}"
            BorderBrush="{StaticResource ArcadeLime}"
            BorderThickness="0,0,2,0">
            <Grid>
                <Rectangle Fill="{StaticResource ArcadeHalftone}" Opacity="0.07" />
                <DockPanel Margin="0,14,0,14" LastChildFill="False">
                    <!-- Logo -->
                    <StackPanel Margin="18,4,12,26" DockPanel.Dock="Top">
                        <Border Style="{StaticResource ArcadeTag}">
                            <TextBlock
                                FontSize="22"
                                Foreground="{StaticResource ArcadeBlack}"
                                Style="{StaticResource ArcadeHeading}"
                                Text="FGC" />
                        </Border>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="17"
                            Foreground="{StaticResource ArcadeLime}"
                            Text="KEYBOARD SPLITTER">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <RadioButton
                        x:Name="NavKeyboards"
                        AutomationProperties.Name="Keyboards"
                        Checked="OnNavChecked"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ArcadeNavItem}"
                        ToolTip="Keyboards">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Keyboard24" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="KEYBOARDS" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="NavMapping"
                        AutomationProperties.Name="Mapping"
                        Checked="OnNavChecked"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ArcadeNavItem}"
                        ToolTip="Mapping">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="XboxController24" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="MAPPING" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="NavLatency"
                        AutomationProperties.Name="Latency"
                        Checked="OnNavChecked"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ArcadeNavItem}"
                        ToolTip="Latency">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Timer24" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="LATENCY" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="NavDrivers"
                        AutomationProperties.Name="Drivers"
                        Checked="OnNavChecked"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ArcadeNavItem}"
                        ToolTip="Drivers">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="ShieldCheckmark24" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="DRIVERS" />
                        </StackPanel>
                    </RadioButton>
                </DockPanel>
            </Grid>
        </Border>

        <Frame
            x:Name="PageHost"
            Grid.Row="1"
            Grid.Column="1"
            Focusable="False"
            NavigationUIVisibility="Hidden" />

        <ui:ContentDialogHost
            x:Name="RootDialogHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2" />
    </Grid>
</ui:FluentWindow>
