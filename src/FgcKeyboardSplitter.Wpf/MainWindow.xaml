<ui:FluentWindow
    x:Class="FgcKeyboardSplitter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:FgcKeyboardSplitter.Views"
    Title="FGC Keyboard Splitter"
    Width="1180"
    Height="820"
    MinWidth="720"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid x:Name="ScaleRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="FGC Keyboard Splitter" Grid.Row="0" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Keyboards"
                    Icon="{ui:SymbolIcon Keyboard24}"
                    TargetPageType="{x:Type views:KeyboardsPage}" />
                <ui:NavigationViewItem
                    Content="Mapping"
                    Icon="{ui:SymbolIcon XboxController24}"
                    TargetPageType="{x:Type views:MappingPage}" />
                <ui:NavigationViewItem
                    Content="Latency"
                    Icon="{ui:SymbolIcon Timer24}"
                    TargetPageType="{x:Type views:LatencyPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Drivers"
                    Icon="{ui:SymbolIcon ShieldCheckmark24}"
                    TargetPageType="{x:Type views:DriversPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:ContentDialogHost
            x:Name="RootDialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
