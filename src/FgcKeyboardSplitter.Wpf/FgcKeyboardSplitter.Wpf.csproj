<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FgcKeyboardSplitter</AssemblyName>
    <RootNamespace>FgcKeyboardSplitter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FgcCoreCopyExtras>true</FgcCoreCopyExtras>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fgc.Interop\Fgc.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FgcKeyboardSplitter.Tests" />
  </ItemGroup>

  <!-- Heading font (SIL Open Font License); the licence has to travel with it. -->
  <ItemGroup>
    <Resource Include="Theme\Fonts\*.ttf" />
    <None Include="Theme\Fonts\ChakraPetch-OFL.txt" Link="licenses\ChakraPetch-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Import Project="..\..\build\FgcCore.targets" />

</Project>
