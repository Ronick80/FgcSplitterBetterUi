<!--
    Arcade theme sketch: black and lime, hard offset shadows, slanted shapes and a halftone backdrop.
    Only plain WPF controls are styled here, so it does not depend on WPF-UI.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="clr-namespace:FgcKeyboardSplitter.Theme"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels">

    <!-- Palette -->
    <Color x:Key="ArcadeBlackColor">#0A0C07</Color>
    <Color x:Key="ArcadeLimeColor">#CDF24B</Color>
    <SolidColorBrush x:Key="ArcadeBlack" Color="{StaticResource ArcadeBlackColor}" />
    <SolidColorBrush x:Key="ArcadePanel" Color="#12160D" />
    <SolidColorBrush x:Key="ArcadePanelRaised" Color="#1B2113" />
    <SolidColorBrush x:Key="ArcadeLine" Color="#2E3722" />
    <SolidColorBrush x:Key="ArcadeLime" Color="{StaticResource ArcadeLimeColor}" />
    <SolidColorBrush x:Key="ArcadeLimeHot" Color="#E4FF7A" />
    <SolidColorBrush x:Key="ArcadeLimeDim" Color="#5F7A16" />
    <SolidColorBrush x:Key="ArcadeCyan" Color="#38D6FF" />
    <SolidColorBrush x:Key="ArcadeRed" Color="#FF3D4A" />
    <SolidColorBrush x:Key="ArcadeRedHot" Color="#FF6B75" />
    <SolidColorBrush x:Key="ArcadeAmber" Color="#FFB020" />
    <SolidColorBrush x:Key="ArcadeSidebar" Color="#060805" />
    <SolidColorBrush x:Key="ArcadeText" Color="#F3F7EA" />
    <SolidColorBrush x:Key="ArcadeTextDim" Color="#97A385" />
    <SolidColorBrush x:Key="ArcadeShadow" Color="#000000" />

    <FontFamily x:Key="ArcadeFont">Bahnschrift, Segoe UI</FontFamily>
    <!-- Chakra Petch: cut corners instead of curves, for the big page titles -->
    <FontFamily x:Key="ArcadeTitleFont">/FgcKeyboardSplitter;component/Theme/Fonts/#Chakra Petch</FontFamily>

    <theme:UpperCaseConverter x:Key="Upper" />

    <!-- Comic halftone dots, tiled -->
    <DrawingBrush
        x:Key="ArcadeHalftone"
        TileMode="Tile"
        Viewbox="0,0,9,9"
        ViewboxUnits="Absolute"
        Viewport="0,0,9,9"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,9,9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource ArcadeLime}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="4.5,4.5" RadiusX="1.2" RadiusY="1.2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Hazard stripes for warnings -->
    <LinearGradientBrush
        x:Key="ArcadeHazard"
        MappingMode="Absolute"
        SpreadMethod="Repeat"
        StartPoint="0,0"
        EndPoint="10,10">
        <GradientStop Offset="0" Color="{StaticResource ArcadeLimeColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource ArcadeLimeColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource ArcadeBlackColor}" />
        <GradientStop Offset="1" Color="{StaticResource ArcadeBlackColor}" />
    </LinearGradientBrush>

    <!-- Text -->
    <Style x:Key="ArcadeHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
    </Style>

    <Style x:Key="ArcadeBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Slanted tag, for labels like PLAYER SELECT, LIVE and READY -->
    <Style x:Key="ArcadeTag" TargetType="Border">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <SkewTransform AngleX="-14" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: slanted face over a hard black shadow; pressing pushes the face onto the shadow. -->
    <Style x:Key="ArcadeButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="24,9" />
        <Setter Property="Margin" Value="0,0,14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource ArcadeBlack}" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeLime}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeLime}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Shadow"
                            Margin="4,4,-4,-4"
                            Background="{StaticResource ArcadeShadow}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <Border
                            x:Name="Face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter
                            x:Name="Content"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="3,3,-3,-3" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="3" Y="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource ArcadeText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
                <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
                <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ArcadePrimaryButton"
        BasedOn="{StaticResource ArcadeButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ArcadeLimeHot}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
                <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ArcadeDangerButton"
        BasedOn="{StaticResource ArcadeButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ArcadeRed}" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ArcadeRedHot}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
                <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Panel with a lime frame, a hard shadow and a notched corner -->
    <Style x:Key="ArcadeCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Margin="6,6,-6,-6" Background="{StaticResource ArcadeShadow}" />
                        <Border
                            Background="{StaticResource ArcadePanel}"
                            BorderBrush="{StaticResource ArcadeLime}"
                            BorderThickness="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Polygon
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{StaticResource ArcadeLime}"
                            Points="0,0 18,0 0,18" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows: dark slab, lime accent bar when selected -->
    <Style x:Key="ArcadeListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border Margin="5,5,-5,-5" Background="{StaticResource ArcadeShadow}" />
                        <Border
                            x:Name="Slab"
                            Background="{StaticResource ArcadePanel}"
                            BorderBrush="{StaticResource ArcadeLine}"
                            BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="Accent"
                                    Width="10"
                                    Background="{StaticResource ArcadeLine}" />
                                <ContentPresenter Grid.Column="1" Margin="20,16" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Slab" Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource ArcadeLimeDim}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Slab" Property="BorderBrush" Value="{StaticResource ArcadeLime}" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slow arcade blink, for "press any key" and LIVE markers -->
    <Storyboard x:Key="ArcadeBlink" RepeatBehavior="Forever">
        <DoubleAnimation
            AutoReverse="True"
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0.2"
            Duration="0:0:0.55" />
    </Storyboard>

    <!-- Page backdrop: black, a lime glow top right, halftone dots fading downwards, and two speed slashes -->
    <Style x:Key="ArcadePage" TargetType="ContentControl">
        <Setter Property="TextElement.FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="{StaticResource ArcadeBlack}" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.7" RadiusY="0.9">
                                    <GradientStop Offset="0" Color="#3ACDF24B" />
                                    <GradientStop Offset="1" Color="#00CDF24B" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Fill="{StaticResource ArcadeHalftone}" Opacity="0.16">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0.3,0.8">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Canvas
                            Width="260"
                            HorizontalAlignment="Right"
                            IsHitTestVisible="False">
                            <Polygon Fill="{StaticResource ArcadeLime}" Opacity="0.9" Points="110,0 190,0 70,180 -10,180" />
                            <Polygon Fill="{StaticResource ArcadeCyan}" Opacity="0.55" Points="210,0 234,0 114,180 90,180" />
                        </Canvas>
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page header: Tag is the small eyebrow label, Content the big double-printed title -->
    <Style x:Key="ArcadeHeader" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <Border Style="{StaticResource ArcadeTag}">
                            <TextBlock
                                FontSize="15"
                                Foreground="{StaticResource ArcadeBlack}"
                                Style="{StaticResource ArcadeHeading}"
                                Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <Grid Margin="-4,0,0,0" HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <SkewTransform AngleX="-10" />
                            </Grid.RenderTransform>
                            <theme:OutlinedText
                                Margin="6,6,0,0"
                                Fill="{StaticResource ArcadeCyan}"
                                FontFamily="{StaticResource ArcadeTitleFont}"
                                FontSize="62"
                                FontWeight="Bold"
                                Stroke="{StaticResource ArcadeBlack}"
                                StrokeThickness="4"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <theme:OutlinedText
                                Fill="{StaticResource ArcadeLime}"
                                FontFamily="{StaticResource ArcadeTitleFont}"
                                FontSize="62"
                                FontWeight="Bold"
                                Stroke="{StaticResource ArcadeBlack}"
                                StrokeThickness="4"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slanted status tag; Tag carries a StatusKind -->
    <Style
        x:Key="ArcadeStatusTag"
        BasedOn="{StaticResource ArcadeTag}"
        TargetType="Border">
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ArcadeTextDim}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Good}">
                <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource ArcadeBlack}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Warning}">
                <Setter Property="Background" Value="{StaticResource ArcadeAmber}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource ArcadeBlack}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Bad}">
                <Setter Property="Background" Value="{StaticResource ArcadeRed}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource ArcadeText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small slanted toggle, used like tabs -->
    <Style x:Key="ArcadeTab" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="20,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border
                            x:Name="Plate"
                            Background="{StaticResource ArcadePanelRaised}"
                            BorderBrush="{StaticResource ArcadeLine}"
                            BorderThickness="2"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource ArcadeLimeDim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource ArcadeLime}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Implicit styles: these replace the Fluent look of the remaining standard controls everywhere in the app.
    -->

    <!-- Scroll bars: a thin rail with a lime thumb -->
    <Style x:Key="ArcadeScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArcadeThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{StaticResource ArcadeLimeDim}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ArcadeVerticalScrollBar" TargetType="ScrollBar">
        <Grid Width="12" Background="Transparent">
            <Rectangle Width="2" Fill="{StaticResource ArcadeLine}" />
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ArcadeScrollPage}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ArcadeScrollPage}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Width="8" Style="{StaticResource ArcadeThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ArcadeHorizontalScrollBar" TargetType="ScrollBar">
        <Grid Height="12" Background="Transparent">
            <Rectangle Height="2" Fill="{StaticResource ArcadeLine}" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ArcadeScrollPage}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ArcadeScrollPage}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Height="8" Style="{StaticResource ArcadeThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Template" Value="{StaticResource ArcadeVerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource ArcadeHorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{TemplateBinding VerticalOffset}" />
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Orientation="Horizontal"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{TemplateBinding HorizontalOffset}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown: a slanted plate like the buttons, with a lime-framed list. Tag is the placeholder text. -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="Background" Value="{StaticResource ArcadePanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeLime}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Cursor="Hand">
                                        <Border Margin="4,4,-4,-4" Background="{StaticResource ArcadeShadow}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <SkewTransform AngleX="-14" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            x:Name="Face"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="2"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <SkewTransform AngleX="-14" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Path
                                            Margin="0,0,18,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 12,0 L 6,7 Z"
                                            Fill="{StaticResource ArcadeLime}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource ArcadeLimeHot}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            Margin="18,0,44,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBlock
                            x:Name="Placeholder"
                            Margin="18,0,44,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ArcadeTextDim}"
                            IsHitTestVisible="False"
                            Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="Collapsed" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,6,0,0"
                                Padding="4"
                                Background="{StaticResource ArcadeBlack}"
                                BorderBrush="{StaticResource ArcadeLime}"
                                BorderThickness="2">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Name="Empty"
                                        Margin="14,8"
                                        Foreground="{StaticResource ArcadeTextDim}"
                                        Text="NOTHING SAVED YET"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows in dropdowns and the key picker: lime bar when highlighted -->
    <Style x:Key="ArcadeRowItem" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style BasedOn="{StaticResource ArcadeRowItem}" TargetType="ComboBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="14,8" Background="Transparent">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ArcadeLime}" />
                            <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArcadePickList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ArcadeBlack}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ArcadePickItem"
        BasedOn="{StaticResource ArcadeRowItem}"
        TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Padding="14,7" Background="Transparent">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ArcadeLime}" />
                            <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-click menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <Border Margin="5,5,-5,-5" Background="{StaticResource ArcadeShadow}" />
                        <Border
                            Padding="4"
                            Background="{StaticResource ArcadeBlack}"
                            BorderBrush="{StaticResource ArcadeLime}"
                            BorderThickness="2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ArcadeRowItem}" TargetType="MenuItem">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Padding="16,9" Background="Transparent">
                        <ContentPresenter
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ArcadeLime}" />
                            <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ArcadeLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Padding="10,5"
                        Background="{StaticResource ArcadeBlack}"
                        BorderBrush="{StaticResource ArcadeLime}"
                        BorderThickness="2">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeText}" />
        <Setter Property="Background" Value="{StaticResource ArcadeBlack}" />
        <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
        <Setter Property="CaretBrush" Value="{StaticResource ArcadeLime}" />
        <Setter Property="SelectionBrush" Value="{StaticResource ArcadeLime}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entry: a slanted lime plate marks the current page -->
    <Style x:Key="ArcadeNavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="ArcadeNav" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource ArcadeFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Plate"
                            Margin="14,4,10,4"
                            Background="Transparent"
                            BorderThickness="2"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-14" />
                            </Border.RenderTransform>
                        </Border>
                        <Border
                            x:Name="Bar"
                            Width="5"
                            HorizontalAlignment="Left"
                            Background="Transparent" />
                        <ContentPresenter
                            Margin="26,0,12,0"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource ArcadeLimeDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource ArcadeText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource ArcadeLime}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ArcadeLime}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ArcadeLime}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
