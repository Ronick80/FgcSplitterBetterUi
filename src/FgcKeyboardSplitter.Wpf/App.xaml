<Application
    x:Class="FgcKeyboardSplitter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Rounded label that shows a state; Tag carries the StatusKind. -->
            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="11,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Good}">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Warning}">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="{x:Static vm:StatusKind.Bad}">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- One of the four XInput slots; Tag carries the SlotKind. -->
            <Style x:Key="SlotPip" TargetType="Border">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{x:Static vm:SlotKind.Mine}">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="{x:Static vm:SlotKind.Other}">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
