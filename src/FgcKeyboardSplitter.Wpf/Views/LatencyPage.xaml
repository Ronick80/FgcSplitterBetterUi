<Page
    x:Class="FgcKeyboardSplitter.Views.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    Title="Latency">

    <ContentControl Style="{StaticResource ArcadePage}">
        <Grid Margin="32,26,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <ContentControl
                    Content="LATENCY"
                    Style="{StaticResource ArcadeHeader}"
                    Tag="FRAME DATA" />
                <TextBlock
                    MaxWidth="640"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ArcadeBody}"
                    Text="All values are in microseconds (1,000 µs = 1 ms): from the mapping thread waking on a key event to the virtual controller accepting the report. Read is the keyboard driver read after waking; Report is the virtual controller call. The rest is the app's own work. It does not include keyboard or USB delay, or how often the game reads the controller." />
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="0,18,0,18">
                <Button
                    Command="{Binding ResetCommand}"
                    Content="RESET STATISTICS"
                    Style="{StaticResource ArcadeButton}" />
            </WrapPanel>

            <TextBlock
                Grid.Row="2"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="24"
                Foreground="{StaticResource ArcadeTextDim}"
                Text="START A KEYBOARD TO SEE ITS FRAME DATA"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoEntries}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LatencyEntry}">
                        <ContentControl Margin="0,0,6,22" Style="{StaticResource ArcadeCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="26"
                                        Style="{StaticResource ArcadeHeading}"
                                        Text="{Binding Title, Converter={StaticResource Upper}}" />
                                    <Border Margin="14,0,0,0" Style="{StaticResource ArcadeTag}">
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="{StaticResource ArcadeBlack}"
                                            Style="{StaticResource ArcadeHeading}"
                                            Text="LIVE" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Stats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatItem}">
                                            <StackPanel Margin="0,0,12,14">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="{StaticResource ArcadeTextDim}"
                                                    Style="{StaticResource ArcadeHeading}"
                                                    Text="{Binding Label, Converter={StaticResource Upper}}" />
                                                <TextBlock
                                                    FontSize="34"
                                                    Foreground="{StaticResource ArcadeLime}"
                                                    Style="{StaticResource ArcadeHeading}"
                                                    Text="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Page>
