<Page
    x:Class="FgcKeyboardSplitter.Views.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    Title="Latency"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Title" Text="Latency" />
                <ui:Button
                    Grid.Column="1"
                    Command="{Binding ResetCommand}"
                    Content="Reset statistics"
                    Icon="{ui:SymbolIcon ArrowReset24}" />
            </Grid>
            <ui:TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="All values are in microseconds (1,000 µs = 1 ms): from the mapping thread waking on a key event to the virtual controller accepting the report. Read is the keyboard driver read after waking; Report is the virtual controller call. The rest is the app's own work. It does not include keyboard or USB delay, or how often the game reads the controller."
                TextWrapping="Wrap" />
        </StackPanel>

        <ui:TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Start a keyboard to see its latency here.">
            <ui:TextBlock.Style>
                <Style TargetType="ui:TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNoEntries}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBlock.Style>
        </ui:TextBlock>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LatencyEntry}">
                        <ui:Card Margin="0,0,0,12">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Stats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatItem}">
                                            <StackPanel Margin="0,0,0,10">
                                                <ui:TextBlock
                                                    FontTypography="Caption"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Label}" />
                                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
