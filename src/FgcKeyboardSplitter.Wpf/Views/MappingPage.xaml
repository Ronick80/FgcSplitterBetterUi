<Page
    x:Class="FgcKeyboardSplitter.Views.MappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:FgcKeyboardSplitter.Views"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    Title="Mapping">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Page.Resources>

    <ContentControl Style="{StaticResource ArcadePage}">
        <Grid Margin="32,26,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <ContentControl
                    Content="MAPPING"
                    Style="{StaticResource ArcadeHeader}"
                    Tag="BUTTON CONFIG" />
                <StackPanel
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding HasKeyboard, Converter={StaticResource Visible}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{StaticResource ArcadeText}"
                        Style="{StaticResource ArcadeHeading}"
                        Text="{Binding Keyboard.Title, Converter={StaticResource Upper}}" />
                    <Border
                        Margin="14,0,0,0"
                        Style="{StaticResource ArcadeStatusTag}"
                        Tag="{Binding Keyboard.StatusKind}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                            Style="{StaticResource ArcadeHeading}"
                            Text="{Binding Keyboard.StatusText, Converter={StaticResource Upper}}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Nothing selected -->
            <TextBlock
                Grid.Row="1"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="24"
                Foreground="{StaticResource ArcadeTextDim}"
                Text="SELECT A KEYBOARD ON THE KEYBOARDS PAGE TO EDIT ITS MAPPING"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasKeyboard}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,16,0,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding HasKeyboard, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Profile -->
                <ContentControl Grid.Row="0" Margin="0,0,6,14" Style="{StaticResource ArcadeCard}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <TextBlock
                                FontSize="22"
                                Foreground="{StaticResource ArcadeLime}"
                                Style="{StaticResource ArcadeHeading}"
                                Text="PROFILE" />
                            <Border
                                Margin="14,0,0,0"
                                Style="{StaticResource ArcadeStatusTag}"
                                Tag="{x:Static vm:StatusKind.Neutral}"
                                ToolTip="Built-in profiles cannot be changed. Use Save as to keep a copy under another name."
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}">
                                <TextBlock
                                    FontSize="14"
                                    Style="{StaticResource ArcadeHeading}"
                                    Text="BUILT-IN" />
                            </Border>
                            <Border
                                Margin="14,0,0,0"
                                Style="{StaticResource ArcadeStatusTag}"
                                Tag="{x:Static vm:StatusKind.Warning}"
                                Visibility="{Binding IsDirty, Converter={StaticResource Visible}}">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource ArcadeBlack}"
                                    Style="{StaticResource ArcadeHeading}"
                                    Text="UNSAVED CHANGES" />
                            </Border>
                        </StackPanel>
                        <WrapPanel>
                            <ComboBox
                                MinWidth="260"
                                Margin="0,0,18,6"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding ProfileNames}"
                                SelectedItem="{Binding SelectedProfile}"
                                Tag="NO PROFILE" />
                            <Button
                                Command="{Binding SaveCommand}"
                                Content="SAVE"
                                Style="{StaticResource ArcadePrimaryButton}" />
                            <Button
                                Command="{Binding SaveAsCommand}"
                                Content="SAVE AS"
                                Style="{StaticResource ArcadeButton}" />
                            <Button
                                Command="{Binding RenameCommand}"
                                Content="RENAME"
                                Style="{StaticResource ArcadeButton}" />
                            <Button
                                Command="{Binding DeleteCommand}"
                                Content="DELETE"
                                Style="{StaticResource ArcadeDangerButton}" />
                        </WrapPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource ArcadeRed}"
                            Style="{StaticResource ArcadeBody}"
                            Text="{Binding Message}"
                            Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ContentControl>

                <!-- View switch, hint and reset -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <RadioButton
                            x:Name="ControllerView"
                            AutomationProperties.Name="Controller view"
                            Content="CONTROLLER"
                            GroupName="MappingView"
                            IsChecked="True"
                            Style="{StaticResource ArcadeTab}" />
                        <RadioButton
                            x:Name="ListViewTab"
                            AutomationProperties.Name="List view"
                            Content="LIST"
                            GroupName="MappingView"
                            Style="{StaticResource ArcadeTab}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ArcadeBody}"
                        Text="Click a button or a key label, then press the new key; click again to cancel. Right-click to pick from a list or clear. Picking also works while the keyboard runs. Changes apply immediately." />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ResetDefaultsCommand}"
                        Content="RESET TO DEFAULTS"
                        Style="{StaticResource ArcadeButton}" />
                </Grid>

                <!-- Controller: as wide as the page; the page scrolls when it is taller than the window -->
                <views:GamepadDiagram
                    Grid.Row="2"
                    MaxWidth="1400"
                    Margin="0,8,6,0"
                    Visibility="{Binding IsChecked, ElementName=ControllerView, Converter={StaticResource Visible}}" />

                <!-- List -->
                <ItemsControl
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    ItemsSource="{Binding RowsView}"
                    Visibility="{Binding IsChecked, ElementName=ListViewTab, Converter={StaticResource Visible}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,18,0,6"
                                            FontSize="20"
                                            Foreground="{StaticResource ArcadeLime}"
                                            Style="{StaticResource ArcadeHeading}"
                                            Text="{Binding Name, Converter={StaticResource Upper}}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MappingRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        Foreground="{StaticResource ArcadeText}"
                                        Style="{StaticResource ArcadeBody}"
                                        Text="{Binding Label}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="200"
                                        Command="{Binding DataContext.ToggleBindCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding ButtonText, Converter={StaticResource Upper}}"
                                        Style="{StaticResource ArcadeButton}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding DataContext.PickKeyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="..."
                                        Style="{StaticResource ArcadeButton}"
                                        ToolTip="Pick a key from a list" />
                                    <Border
                                        Grid.Column="3"
                                        Style="{StaticResource ArcadeStatusTag}"
                                        Tag="{x:Static vm:StatusKind.Warning}"
                                        ToolTip="This key is also bound to another input."
                                        Visibility="{Binding IsShared, Converter={StaticResource Visible}}">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource ArcadeBlack}"
                                            Style="{StaticResource ArcadeHeading}"
                                            Text="SHARED KEY" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Page>
