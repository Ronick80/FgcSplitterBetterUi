<Page
    x:Class="FgcKeyboardSplitter.Views.MappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    Title="Mapping">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="Mapping" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasKeyboard}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Keyboard.Title}" />
                <Border
                    Margin="12,0,0,0"
                    Style="{StaticResource StatusPill}"
                    Tag="{Binding Keyboard.StatusKind}">
                    <ui:TextBlock FontTypography="Caption" Text="{Binding Keyboard.StatusText}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Nothing selected -->
        <ui:TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Select a keyboard on the Keyboards page to edit its mapping.">
            <ui:TextBlock.Style>
                <Style TargetType="ui:TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKeyboard}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBlock.Style>
        </ui:TextBlock>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKeyboard}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Profile -->
            <ui:Card Grid.Row="0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <ui:TextBlock FontTypography="BodyStrong" Text="Profile" />
                        <Border
                            Margin="12,0,0,0"
                            Style="{StaticResource StatusPill}"
                            Tag="{x:Static vm:StatusKind.Warning}">
                            <Border.Visibility>
                                <Binding Path="IsDirty">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <ui:TextBlock FontTypography="Caption" Text="Unsaved changes" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                            MinWidth="240"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding ProfileNames}"
                            SelectedItem="{Binding SelectedProfile}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="Save"
                            Icon="{ui:SymbolIcon Save24}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding SaveAsCommand}"
                            Content="Save as..." />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding RenameCommand}"
                            Content="Rename..." />
                        <ui:Button Command="{Binding DeleteCommand}" Content="Delete..." />
                    </StackPanel>
                    <ui:TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding Message}"
                        TextWrapping="Wrap">
                        <ui:TextBlock.Visibility>
                            <Binding Path="HasMessage">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </ui:TextBlock.Visibility>
                    </ui:TextBlock>
                </StackPanel>
            </ui:Card>

            <!-- Hint and reset -->
            <Grid Grid.Row="1" Margin="0,14,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Click a key button, then press the new key; click it again to cancel. Use ... to pick from a list instead; that also works while the keyboard runs, when its keys are hidden from this window. Changes apply immediately."
                    TextWrapping="Wrap" />
                <ui:Button
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding ResetDefaultsCommand}"
                    Content="Reset to defaults"
                    Icon="{ui:SymbolIcon ArrowReset24}" />
            </Grid>

            <!-- Bindings, grouped -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RowsView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <ui:TextBlock
                                        Margin="0,16,0,4"
                                        FontTypography="BodyStrong"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MappingRow}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="180"
                                    Command="{Binding DataContext.ToggleBindCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding ButtonText}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.PickKeyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Content="..."
                                    ToolTip="Pick a key from a list" />
                                <ui:SymbolIcon
                                    Grid.Column="3"
                                    Margin="10,0,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="Info24"
                                    ToolTip="This key is also bound to another input.">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
