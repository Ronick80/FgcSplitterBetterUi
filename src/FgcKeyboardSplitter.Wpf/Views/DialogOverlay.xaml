<UserControl
    x:Class="FgcKeyboardSplitter.Views.DialogOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Grid>
        <!-- Dims and blocks the page while a dialog is open -->
        <Rectangle Fill="#D9000000" />
        <Rectangle Fill="{StaticResource ArcadeHalftone}" Opacity="0.06" />

        <ContentControl
            MinWidth="440"
            MaxWidth="600"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource ArcadeCard}">
            <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                <Border Style="{StaticResource ArcadeTag}">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="18"
                        Foreground="{StaticResource ArcadeBlack}"
                        Style="{StaticResource ArcadeHeading}" />
                </Border>
                <ContentPresenter x:Name="BodyHost" Margin="0,18,0,22" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Click="OnPrimary" />
                    <Button
                        x:Name="CloseButton"
                        Margin="0,0,4,4"
                        Click="OnClose"
                        Style="{StaticResource ArcadeButton}" />
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
