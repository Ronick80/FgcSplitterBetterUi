<UserControl
    x:Class="FgcKeyboardSplitter.Views.GamepadDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FgcKeyboardSplitter.Views"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:DiagramStyles />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="{x:Static vm:GamepadLayout.CanvasWidth}" Height="{x:Static vm:GamepadLayout.CanvasHeight}">
            <!-- Body -->
            <Path
                Data="{x:Static vm:GamepadLayout.Body}"
                Fill="{StaticResource PadBodyFill}"
                Stroke="{StaticResource ArcadeText}"
                StrokeLineJoin="Round"
                StrokeThickness="3.5" />
            <Path
                Data="{x:Static vm:GamepadLayout.FaceLines}"
                Stroke="{StaticResource ArcadeText}"
                StrokeLineJoin="Round"
                StrokeThickness="3" />
            <Path
                Data="{x:Static vm:GamepadLayout.OuterRings}"
                Stroke="{StaticResource PadDim}"
                StrokeThickness="2.5" />
            <Path
                Data="{x:Static vm:GamepadLayout.StickRings}"
                Stroke="{StaticResource ArcadeText}"
                StrokeThickness="3" />

            <!-- Label groups: a titled panel per stick, d-pad, face buttons and trigger/bumper pair -->
            <ItemsControl ItemsPanel="{StaticResource CanvasPanel}" ItemsSource="{x:Static vm:GamepadLayout.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiagramGroup}">
                        <Canvas>
                            <Polyline
                                Points="{Binding Leader}"
                                Stroke="{StaticResource PadLine}"
                                StrokeThickness="2.5" />
                            <Ellipse
                                Canvas.Left="{Binding LeaderDot.Left}"
                                Canvas.Top="{Binding LeaderDot.Top}"
                                Width="10"
                                Height="10"
                                Fill="{StaticResource PadLine}"
                                Visibility="{Binding HasLeader, Converter={StaticResource Visible}}" />
                            <Border
                                Canvas.Left="{Binding Bounds.Left}"
                                Canvas.Top="{Binding Bounds.Top}"
                                Width="{Binding Bounds.Width}"
                                Height="{Binding Bounds.Height}"
                                Background="{StaticResource PadGroupFill}"
                                BorderBrush="{StaticResource PadDim}"
                                BorderThickness="2"
                                CornerRadius="6">
                                <TextBlock
                                    Margin="10,4,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="15"
                                    Foreground="{StaticResource ArcadeTextDim}"
                                    Style="{StaticResource ArcadeHeading}"
                                    Text="{Binding Title}" />
                            </Border>
                            <ItemsControl ItemsPanel="{StaticResource CanvasPanel}" ItemsSource="{Binding Captions}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Bounds.Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Bounds.Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GroupCaption}">
                                        <Grid Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                Foreground="{StaticResource ArcadeText}"
                                                Style="{StaticResource ArcadeHeading}"
                                                Text="{Binding Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Leader lines, under everything that lights up -->
            <ItemsControl ItemsPanel="{StaticResource CanvasPanel}" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MappingRow}">
                        <Polyline Points="{Binding LeaderPoints}" Style="{StaticResource PadLeader}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The inputs themselves -->
            <ItemsControl ItemsPanel="{StaticResource CanvasPanel}" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MappingRow}">
                        <Button Style="{StaticResource PadHotspot}">
                            <Canvas>
                                <Path Data="{Binding Shape}" Style="{StaticResource PadShape}" />
                                <Path Data="{Binding Glyph}" Style="{StaticResource PadGlyph}" />
                                <Grid
                                    Canvas.Left="{Binding LetterLeft}"
                                    Canvas.Top="{Binding LetterTop}"
                                    Width="{x:Static vm:GamepadLayout.LetterBox}"
                                    Height="{x:Static vm:GamepadLayout.LetterBox}">
                                    <TextBlock Style="{StaticResource PadLetter}" Text="{Binding Letter}" />
                                </Grid>
                            </Canvas>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Path
                Data="{x:Static vm:GamepadLayout.DpadCross}"
                IsHitTestVisible="False"
                Stroke="{StaticResource ArcadeText}"
                StrokeLineJoin="Round"
                StrokeThickness="3" />

            <!-- Key labels: the only text on the drawing -->
            <ItemsControl ItemsPanel="{StaticResource CanvasPanel}" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding ChipLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding ChipTop}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MappingRow}">
                        <Button Style="{StaticResource PadHotspot}">
                            <Grid Width="{Binding ChipWidth}" Height="{x:Static vm:GamepadLayout.ChipHeight}">
                                <Border Margin="4,4,-4,-4" Background="{StaticResource ArcadeShadow}">
                                    <Border.RenderTransform>
                                        <SkewTransform AngleX="-14" CenterY="18" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Style="{StaticResource ChipPlate}" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding ChipText, Converter={StaticResource Upper}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
