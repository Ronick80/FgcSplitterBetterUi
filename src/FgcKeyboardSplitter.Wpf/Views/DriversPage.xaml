<Page
    x:Class="FgcKeyboardSplitter.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Drivers">

    <ContentControl Style="{StaticResource ArcadePage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,24">
                <ContentControl
                    Content="DRIVERS"
                    Style="{StaticResource ArcadeHeader}"
                    Tag="SYSTEM CHECK" />
                <TextBlock
                    MaxWidth="560"
                    Margin="0,2,0,22"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ArcadeBody}"
                    Text="Two Windows drivers do the work: one captures a keyboard, the other provides the virtual controllers." />

                <!-- Could not read the status -->
                <Border
                    Margin="0,0,0,18"
                    Background="{StaticResource ArcadePanel}"
                    BorderBrush="{StaticResource ArcadeRed}"
                    BorderThickness="2">
                    <Border.Visibility>
                        <Binding Path="HasQueryProblem">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource ArcadeRed}" />
                        <StackPanel Grid.Column="1" Margin="16,10">
                            <TextBlock
                                FontSize="20"
                                Foreground="{StaticResource ArcadeRed}"
                                Style="{StaticResource ArcadeHeading}"
                                Text="STATUS UNKNOWN" />
                            <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding QueryProblem}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Interception -->
                <ContentControl Margin="0,0,6,22" Style="{StaticResource ArcadeCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="28"
                                Style="{StaticResource ArcadeHeading}"
                                Text="INTERCEPTION" />
                            <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding InterceptionDetail}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Style="{StaticResource ArcadeStatusTag}"
                            Tag="{Binding InterceptionKind}">
                            <TextBlock
                                FontSize="17"
                                Style="{StaticResource ArcadeHeading}"
                                Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                Text="{Binding InterceptionStatus, Converter={StaticResource Upper}}" />
                        </Border>
                    </Grid>
                </ContentControl>

                <!-- ScpVBus -->
                <ContentControl Margin="0,0,6,26" Style="{StaticResource ArcadeCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="28"
                                Style="{StaticResource ArcadeHeading}"
                                Text="SCPVBUS" />
                            <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding ScpVBusDetail}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Style="{StaticResource ArcadeStatusTag}"
                            Tag="{Binding ScpVBusKind}">
                            <TextBlock
                                FontSize="17"
                                Style="{StaticResource ArcadeHeading}"
                                Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                Text="{Binding ScpVBusStatus, Converter={StaticResource Upper}}" />
                        </Border>
                    </Grid>
                </ContentControl>

                <WrapPanel>
                    <Button
                        Command="{Binding RunSetupCommand}"
                        Content="INSTALL OR REPAIR DRIVERS"
                        Style="{StaticResource ArcadePrimaryButton}" />
                    <Button
                        Command="{Binding RecheckCommand}"
                        Content="CHECK AGAIN"
                        Style="{StaticResource ArcadeButton}" />
                </WrapPanel>

                <TextBlock
                    MaxWidth="560"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ArcadeBody}"
                    Text="Opens the driver setup tool, which asks for administrator rights. Interception needs a restart of Windows afterwards." />

                <!-- Result of the setup tool -->
                <Border Margin="0,18,0,0" Background="{StaticResource ArcadePanel}" BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="BorderBrush" Value="{StaticResource ArcadeCyan}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSetupMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SetupMessageIsError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource ArcadeRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,10">
                        <TextBlock
                            FontSize="20"
                            Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                            Style="{StaticResource ArcadeHeading}"
                            Text="DRIVER SETUP" />
                        <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding SetupMessage}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,32,0,0"
                    FontSize="13"
                    Foreground="{StaticResource ArcadeTextDim}"
                    Text="{Binding AboutText, Converter={StaticResource Upper}}" />
            </StackPanel>
        </ScrollViewer>
    </ContentControl>
</Page>
