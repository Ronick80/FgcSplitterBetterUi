<Page
    x:Class="FgcKeyboardSplitter.Views.KeyboardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:FgcKeyboardSplitter.ViewModels"
    Title="Keyboards"
    TextElement.FontFamily="Bahnschrift, Segoe UI"
    TextElement.Foreground="#F3F7EA">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgcKeyboardSplitter;component/Theme/Arcade.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid ClipToBounds="True">
        <!-- Backdrop: black, a lime glow top right, halftone dots fading downwards, and two speed slashes -->
        <Rectangle Fill="{StaticResource ArcadeBlack}" />
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.7" RadiusY="0.9">
                    <GradientStop Offset="0" Color="#3ACDF24B" />
                    <GradientStop Offset="1" Color="#00CDF24B" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Fill="{StaticResource ArcadeHalftone}" Opacity="0.16">
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0.3,0.8">
                    <GradientStop Offset="0" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
        <Canvas
            Width="260"
            HorizontalAlignment="Right"
            IsHitTestVisible="False">
            <Polygon Fill="{StaticResource ArcadeLime}" Opacity="0.9" Points="110,0 190,0 70,180 -10,180" />
            <Polygon Fill="{StaticResource ArcadeCyan}" Opacity="0.55" Points="210,0 234,0 114,180 90,180" />
        </Canvas>

        <Grid Margin="32,26,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource ArcadeTag}">
                    <TextBlock
                        FontSize="15"
                        Foreground="{StaticResource ArcadeBlack}"
                        Style="{StaticResource ArcadeHeading}"
                        Text="PLAYER SELECT" />
                </Border>
                <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                    <Grid.RenderTransform>
                        <SkewTransform AngleX="-10" />
                    </Grid.RenderTransform>
                    <TextBlock
                        Margin="5,5,0,0"
                        FontSize="68"
                        Foreground="{StaticResource ArcadeCyan}"
                        Style="{StaticResource ArcadeHeading}"
                        Text="KEYBOARDS" />
                    <TextBlock
                        FontSize="68"
                        Foreground="{StaticResource ArcadeLime}"
                        Style="{StaticResource ArcadeHeading}"
                        Text="KEYBOARDS" />
                </Grid>
                <TextBlock
                    MaxWidth="480"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ArcadeBody}"
                    Text="Start a keyboard to turn it into its own virtual Xbox controller. While it runs, its keys are hidden from other programs." />
            </StackPanel>

            <!-- Driver warning -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDriverWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{StaticResource ArcadePanel}" BorderBrush="{StaticResource ArcadeLime}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource ArcadeHazard}" />
                        <StackPanel Grid.Column="1" Margin="16,10" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                Foreground="{StaticResource ArcadeLime}"
                                Style="{StaticResource ArcadeHeading}"
                                Text="DRIVER MISSING" />
                            <TextBlock Style="{StaticResource ArcadeBody}" Text="Keyboards cannot start until both drivers are installed and active." />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Command="{Binding ShowDriversCommand}"
                            Content="OPEN DRIVERS"
                            Style="{StaticResource ArcadeButton}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Notices from the engine -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Notice}">
                        <Border
                            Margin="0,12,0,0"
                            Background="{StaticResource ArcadePanel}"
                            BorderBrush="{StaticResource ArcadeRed}"
                            BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource ArcadeRed}" />
                                <StackPanel Grid.Column="1" Margin="16,10">
                                    <TextBlock
                                        FontSize="18"
                                        Foreground="{StaticResource ArcadeRed}"
                                        Style="{StaticResource ArcadeHeading}"
                                        Text="K.O. - KEYBOARD STOPPED" />
                                    <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding Text}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Content="DISMISS"
                                    Style="{StaticResource ArcadeButton}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Controller slots as player slots -->
            <ContentControl Grid.Row="3" Margin="0,22,6,18" Style="{StaticResource ArcadeCard}">
                <WrapPanel>
                    <ItemsControl Margin="0,0,8,0" VerticalAlignment="Center" ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlotItem}">
                                <Grid Width="100" Height="70" Margin="0,6,16,6">
                                    <Border Margin="4,4,-4,-4" Background="{StaticResource ArcadeShadow}">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-14" CenterY="35" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Plate" BorderThickness="2">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-14" CenterY="35" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Mine}">
                                                        <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Other}">
                                                        <Setter Property="Background" Value="{StaticResource ArcadeCyan}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ArcadeBlack}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style x:Key="SlotText" BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Mine}">
                                                        <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Other}">
                                                        <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock
                                            FontSize="28"
                                            Style="{StaticResource SlotText}"
                                            Text="{Binding PlayerLabel}" />
                                        <TextBlock FontSize="13">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource SlotText}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OPEN" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Mine}">
                                                            <Setter Property="Text" Value="THIS APP" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:SlotKind.Other}">
                                                            <Setter Property="Text" Value="OTHER PAD" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        MaxWidth="420"
                        Margin="0,6,0,6"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="24"
                            Foreground="{StaticResource ArcadeLime}"
                            Style="{StaticResource ArcadeHeading}"
                            Text="CONTROLLER SLOTS" />
                        <TextBlock Style="{StaticResource ArcadeBody}" Text="{Binding SlotsText}" />
                        <TextBlock
                            Foreground="{StaticResource ArcadeRed}"
                            Style="{StaticResource ArcadeBody}"
                            Text="No free slot: Windows supports at most 4 controllers in total.">
                            <TextBlock.Visibility>
                                <Binding Path="SlotsFull">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                </WrapPanel>
            </ContentControl>

            <!-- List actions -->
            <WrapPanel Grid.Row="4" Margin="0,0,0,14">
                <Button
                    Command="{Binding RefreshCommand}"
                    Content="REFRESH LIST"
                    Style="{StaticResource ArcadeButton}" />
                <Button
                    Command="{Binding ToggleIdentifyCommand}"
                    Content="{Binding IdentifyButtonText, Converter={StaticResource Upper}}"
                    Style="{StaticResource ArcadeButton}" />
                <Button
                    Command="{Binding StopAllCommand}"
                    Content="STOP ALL"
                    Style="{StaticResource ArcadeDangerButton}" />
            </WrapPanel>

            <!-- Keyboard list -->
            <Grid Grid.Row="5">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ArcadeListItem}"
                    ItemsSource="{Binding Keyboards}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KeyboardItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Width="44" Height="44" Margin="0,0,18,0">
                                    <Path
                                        Data="F0 M1,5 H23 V19 H1 Z M4,8 H6.5 V10.5 H4 Z M8.5,8 H11 V10.5 H8.5 Z M13,8 H15.5 V10.5 H13 Z M17.5,8 H20 V10.5 H17.5 Z M6,13.5 H18 V16 H6 Z"
                                        Fill="{StaticResource ArcadeLime}" />
                                </Viewbox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="28"
                                        Style="{StaticResource ArcadeHeading}"
                                        Text="{Binding Title, Converter={StaticResource Upper}}" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{StaticResource ArcadeTextDim}"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- READY / LIVE -->
                                <Grid Grid.Column="2" Margin="16,0">
                                    <Border>
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource ArcadeTag}" TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource ArcadePanelRaised}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ArcadeLine}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ArcadeLime}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Fill="{StaticResource ArcadeBlack}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="LiveBlink" Storyboard="{StaticResource ArcadeBlink}" />
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="LiveBlink" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="16">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                                                        <Setter Property="Text" Value="READY" />
                                                        <Setter Property="Foreground" Value="{StaticResource ArcadeTextDim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Text" Value="LIVE" />
                                                                <Setter Property="Foreground" Value="{StaticResource ArcadeBlack}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.EditMappingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Content="EDIT MAPPING"
                                    Style="{StaticResource ArcadeButton}" />

                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <Button
                                        MinWidth="124"
                                        Margin="0,0,4,4"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="START">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ArcadePrimaryButton}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        MinWidth="124"
                                        Margin="0,0,4,4"
                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="STOP">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ArcadeDangerButton}" TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Foreground="{StaticResource ArcadeTextDim}"
                    Text="NO KEYBOARDS FOUND - PLUG ONE IN AND HIT REFRESH">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoKeyboards}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Messages -->
            <StackPanel Grid.Row="6" Margin="0,8,0,0">
                <TextBlock
                    FontSize="26"
                    Foreground="{StaticResource ArcadeCyan}"
                    Text="PRESS ANY KEY ON THE KEYBOARD YOU WANT">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource ArcadeHeading}" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIdentifying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="PressAnyKeyBlink" Storyboard="{StaticResource ArcadeBlink}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PressAnyKeyBlink" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Foreground="{StaticResource ArcadeCyan}"
                    Style="{StaticResource ArcadeBody}"
                    Text="{Binding ListProblem}" />
                <TextBlock Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource ArcadeBody}" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ArcadeLime}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ArcadeRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
