<Project>
  <!-- Copies FgcCore.dll next to the output, fetching the pinned release first when .\core is still empty.
       Set FgcCoreCopyExtras=true to also copy FgcDriverSetup.exe and the drivers folder. -->
  <PropertyGroup>
    <FgcDefaultCoreDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\core'))</FgcDefaultCoreDir>
    <FgcCoreDirFull>$([System.IO.Path]::GetFullPath('$(FgcCoreDir)'))</FgcCoreDirFull>
  </PropertyGroup>

  <Target Name="FetchFgcCore" Condition="!Exists('$(FgcCoreDir)\FgcCore.dll')">
    <Exec Condition="'$(FgcCoreDirFull.TrimEnd(`\`))' == '$(FgcDefaultCoreDir.TrimEnd(`\`))'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Get-FgcCore.ps1&quot;" />
    <Error Condition="!Exists('$(FgcCoreDir)\FgcCore.dll')"
           Text="FgcCore.dll was not found in $(FgcCoreDir). Run scripts\Get-FgcCore.ps1, or set FgcCoreDir / FGC_CORE_DIR to a folder that has it." />
  </Target>

  <!-- Items are added inside a target so they see the files the fetch just created. -->
  <Target Name="AddFgcCoreFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="FetchFgcCore">
    <ItemGroup>
      <None Include="$(FgcCoreDir)\FgcCore.dll" Link="FgcCore.dll" CopyToOutputDirectory="PreserveNewest" />
      <None Condition="'$(FgcCoreCopyExtras)' == 'true'" Include="$(FgcCoreDir)\FgcDriverSetup.exe" Link="FgcDriverSetup.exe" CopyToOutputDirectory="PreserveNewest" />
      <None Condition="'$(FgcCoreCopyExtras)' == 'true'" Include="$(FgcCoreDir)\drivers\**" Link="drivers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
